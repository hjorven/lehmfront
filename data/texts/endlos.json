      },
      "text": "Woche {woche}. Die Liste der letzten Woche hat einen Namen. Einer ist zu viel, sagt {gruppenfuehrer_nachname}, und sonst sagt niemand etwas."
    },
    {
      "id": "endlos.woche.verluste",
      "art": "endlos-woche",
      "slot": "endlos.woche",
      "text": "Woche {woche}. Die Liste der letzten Woche hat {anzahl} Namen. Wo Lücken sind, rücken die anderen zusammen und reden nicht darüber."
    },
    {
      "id": "endlos.fruehling.wechsel",
      "art": "jahreszeit",
      "jahreszeit": "fruehling",
      "teil": "wechsel",
      "titel": "Frühjahr",
      "text": "Das Eis in den Gräben bricht. Darunter liegt der Lehm vom Winter, und er ist tiefer als im Herbst."
    },
    {
      "id": "endlos.fruehling.wetter.1",
      "art": "jahreszeit",
      "jahreszeit": "fruehling",
      "teil": "wetter",
      "wann": {
        "wetter": [
          "regen",
          "schlamm"
        ]
      },
      "text": "Tauwetter. Die Grabensohle weicht auf, die Lattenroste schwimmen."
    },
    {
      "id": "endlos.fruehling.wetter.2",
      "art": "jahreszeit",
      "jahreszeit": "fruehling",
      "teil": "wetter",
      "wann": {
        "wetter": "trocken"
      },
      "text": "Erster warmer Tag. Die Leute ziehen die Mäntel aus und frieren nachts wieder."
    },
    {
      "id": "endlos.fruehling.wetter.3",
      "art": "jahreszeit",
      "jahreszeit": "fruehling",
      "teil": "wetter",
      "wann": {
        "wetter": "nebel"
      },
      "text": "Über der Weide steht Dunst. Irgendwo hinter der Linie blüht etwas. Man riecht es nur, wenn der Wind dreht."
    },
    {
      "id": "endlos.fruehling.wetter.rueckfall",
      "art": "jahreszeit",
      "jahreszeit": "fruehling",
      "teil": "wetter",
      "text": "Ein Frühjahrstag wie die anderen. Der Lehm klebt, die Tage werden länger, und niemand traut dem."
    },
    {
      "id": "endlos.sommer.wechsel",
      "art": "jahreszeit",
      "jahreszeit": "sommer",
      "teil": "wechsel",
      "titel": "Sommer",
      "text": "Der Lehm wird hart und reißt auf. Staub statt Schlamm, Durst statt Kälte."
    },
    {
      "id": "endlos.sommer.wetter.1",
      "art": "jahreszeit",
      "jahreszeit": "sommer",
      "teil": "wetter",
      "wann": {
        "wetter": "trocken"
      },
      "text": "Hitze. Die Wasserkanister sind wichtiger als die Munition."
    },
    {
      "id": "endlos.sommer.wetter.2",
      "art": "jahreszeit",
      "jahreszeit": "sommer",
      "teil": "wetter",
      "wann": {
        "wetter": "regen"
      },
      "text": "Gewitter am Nachmittag. Der Graben steht eine Stunde lang unter Wasser, dann dampft er."
    },
    {
      "id": "endlos.sommer.wetter.3",
      "art": "jahreszeit",
      "jahreszeit": "sommer",
      "teil": "wetter",
      "wann": {
        "wetter": "nebel"
      },
      "text": "Morgennebel über der Weide, der erst gegen Mittag aufreißt. Bis dahin hört man drüben Löffel an Kochgeschirr."
    },
    {
      "id": "endlos.sommer.wetter.rueckfall",
      "art": "jahreszeit",
      "jahreszeit": "sommer",
      "teil": "wetter",
      "text": "Ein Sommertag wie die anderen. Staub in den Augen, Fliegen am Brot, und abends ein Himmel, der nicht hierher passt."
    },
    {
      "id": "endlos.herbst.wechsel",
      "art": "jahreszeit",
      "jahreszeit": "herbst",
      "teil": "wechsel",
      "titel": "Herbst",
      "text": "Der Regen kommt und hört nicht mehr auf. Die tiefste Stelle im Graben läuft als Erstes voll, wie jedes Jahr."
    },
    {
      "id": "endlos.herbst.wetter.1",
      "art": "jahreszeit",
      "jahreszeit": "herbst",
      "teil": "wetter",
      "wann": {
        "wetter": [
          "regen",
          "schlamm"
        ]
      },
      "text": "Dauerregen. Der Graben ist ein Bach, und der Bach fließt zum Unterstand."
    },
    {
      "id": "endlos.herbst.wetter.2",
      "art": "jahreszeit",
      "jahreszeit": "herbst",
      "teil": "wetter",
      "wann": {
        "wetter": "nebel"
      },
      "text": "Nebel am Morgen, so dicht, dass sich die Posten gegenseitig beim Namen rufen."
    },
    {
      "id": "endlos.herbst.wetter.3",
      "art": "jahreszeit",
      "jahreszeit": "herbst",
      "teil": "wetter",
      "wann": {
        "wetter": "trocken"
      },
      "text": "Sturm ohne Regen. Der Draht singt die ganze Nacht."
    },
    {
      "id": "endlos.herbst.wetter.rueckfall",
      "art": "jahreszeit",
      "jahreszeit": "herbst",
      "teil": "wetter",
      "text": "Ein Herbsttag wie die anderen. Grau von morgens bis abends, und die Mäntel werden nicht mehr trocken."
    },
    {
      "id": "endlos.winter.wechsel",
      "art": "jahreszeit",
      "jahreszeit": "winter",
      "teil": "wechsel",
      "titel": "Winter",
      "text": "Frost. Der Lehm wird zu Stein, das Graben dauert doppelt so lange. Die Nächte werden lang, und die Posten zählen Leuchtkugeln, um wach zu bleiben."
    },
    {
      "id": "endlos.winter.wetter.1",
      "art": "jahreszeit",
      "jahreszeit": "winter",
      "teil": "wetter",
      "wann": {
        "wetter": "schnee"
      },
      "text": "Schnee deckt die Weide zu. Für einen Morgen sieht es aus, als wäre nie etwas gewesen."
    },
    {
      "id": "endlos.winter.wetter.2",
      "art": "jahreszeit",
      "jahreszeit": "winter",
      "teil": "wetter",
      "wann": {
        "wetter": "regen"
      },
      "text": "Eisregen. Die Leitern sind glatt, und das Kühlwasser im MG friert, wenn niemand aufpasst."
    },
    {
      "id": "endlos.winter.wetter.3",
      "art": "jahreszeit",
      "jahreszeit": "winter",
      "teil": "wetter",
      "wann": {
        "wetter": "frost"
      },
      "text": "Klirrende Kälte. Jemand hat einen Ofen aus einer Munitionskiste gebaut. Er wärmt nicht, aber alle sitzen darum."
    },
    {
      "id": "endlos.winter.wetter.rueckfall",
      "art": "jahreszeit",
      "jahreszeit": "winter",
      "teil": "wetter",
      "text": "Ein Wintertag wie die anderen. Kurz, kalt, und die Posten zählen die Stunden bis zur Ablösung."
    },
    {
      "id": "endlos.ende.gefallen",
